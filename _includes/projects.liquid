{% if project.portfolio_id %}
{% assign entry = site.data.portfolio.projects | where: 'path', project.portfolio_id | first %}
<div class="col mb-3">
  <div class="card h-100 hoverable">
    <div class="card-body">
      <h3 class="h5"><a href="{{ project.url | relative_url }}">{{ project.title | escape }}</a></h3>
      <p>{{ project.description | escape }}</p>
      <p class="small"><span class="border rounded px-2 py-1">{{ entry.status_label | escape }}</span></p>
      <a href="{{ project.url | relative_url }}">Example and project story</a> · <a href="{{ entry.url }}">Source</a>
    </div>
  </div>
</div>
{% else %}
<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
{% endif %}
