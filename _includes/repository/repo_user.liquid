<div class="repo p-2 text-center">
  <a
    href="https://github.com/{{ include.username }}"
    class="d-inline-flex flex-column align-items-center text-decoration-none"
  >
    <img
      class="rounded-circle mb-2"
      alt="{{ include.username }} avatar"
      width="96"
      height="96"
      loading="lazy"
      src="https://github.com/{{ include.username }}.png"
    >
    <span class="font-weight-bold">{{ include.username }}</span>
  </a>
</div>
